<Window x:Class="ClonerApp.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProdigyDownloader"
        Height="640" Width="980"
        MinHeight="480" MinWidth="800"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="20">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <Button Content="New Project" Style="{StaticResource PrimaryButton}" Command="{Binding NewProjectCommand}" Margin="0,0,8,0"/>
                <Button Content="Refresh" Style="{StaticResource SecondaryButton}" Command="{Binding LoadProjectsCommand}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Image Source="/Assets/logo-icon.png" Width="44" Height="44" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Prodigy" FontSize="26" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="Downloader" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                    </StackPanel>
                    <TextBlock Text="by ProdigyNova — download images and videos from websites"
                               Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <Border DockPanel.Dock="Bottom" Padding="0,12,0,0">
            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,12,0" Padding="0">
                <DataGrid ItemsSource="{Binding Projects}"
                          SelectedItem="{Binding SelectedProject}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          RowHeaderWidth="0"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.2*"/>
                        <DataGridTextColumn Header="URL" Binding="{Binding StartUrl}" Width="2*"/>
                        <DataGridTextColumn Header="Mode" Binding="{Binding RunMode}" Width="0.7*"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding LastStatus}" Width="0.8*"/>
                        <DataGridTextColumn Header="Stats" Binding="{Binding Stats}" Width="1.2*"/>
                        <DataGridTextColumn Header="Next run" Binding="{Binding NextRun}" Width="1*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Actions" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <Button Content="Start" Style="{StaticResource PrimaryButton}" Command="{Binding StartSelectedCommand}" Margin="0,0,0,8" HorizontalAlignment="Stretch"/>
                    <Button Content="Edit" Style="{StaticResource SecondaryButton}" Command="{Binding EditSelectedCommand}" Margin="0,0,0,8" HorizontalAlignment="Stretch"/>
                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CancelSelectedCommand}" Margin="0,0,0,8" HorizontalAlignment="Stretch"/>
                    <Button Content="Details" Style="{StaticResource SecondaryButton}" Command="{Binding OpenDetailsCommand}" Margin="0,0,0,8" HorizontalAlignment="Stretch"/>
                    <Button Content="Open folder" Style="{StaticResource SecondaryButton}" Command="{Binding OpenFolderCommand}" Margin="0,0,0,8" HorizontalAlignment="Stretch"/>
                    <Button Content="Enable / Disable" Style="{StaticResource SecondaryButton}" Command="{Binding ToggleEnabledCommand}" Margin="0,0,0,8" HorizontalAlignment="Stretch"/>
                    <Button Content="Delete" Style="{StaticResource SecondaryButton}" Command="{Binding DeleteSelectedCommand}" HorizontalAlignment="Stretch"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,0"
                               Text="Edit opens full project settings. New Project opens the setup wizard."/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
