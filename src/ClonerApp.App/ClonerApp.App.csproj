<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>ProdigyDownloader</AssemblyName>
    <RootNamespace>ClonerApp.App</RootNamespace>
    <Product>ProdigyDownloader</Product>
    <Company>ProdigyNova</Company>
    <Authors>ProdigyNova</Authors>
    <Description>ProdigyDownloader by ProdigyNova: crawl websites and download images and videos.</Description>
    <Copyright>Copyright (c) ProdigyNova - https://www.prodigynova.com</Copyright>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClonerApp.Core\ClonerApp.Core.csproj" />
    <ProjectReference Include="..\ClonerApp.Engine\ClonerApp.Engine.csproj" />
    <ProjectReference Include="..\ClonerApp.Infrastructure\ClonerApp.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\logo-icon.png" />
    <Resource Include="Assets\logo-full.png" />
  </ItemGroup>

</Project>
