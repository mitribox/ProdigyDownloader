<Window x:Class="ClonerApp.App.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProdigyDownloader"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="#0A0A0B"
        Width="520" Height="420"
        AllowsTransparency="False">
    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Root"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.45"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border x:Name="Root" Background="#0A0A0B" Opacity="0" BorderBrush="#2A2A32" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Image Grid.Row="1"
                   Source="/Assets/logo-icon.png"
                   Width="148" Height="148"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                <TextBlock Text="Prodigy" FontSize="32" FontWeight="SemiBold" Foreground="White"/>
                <TextBlock Text="Downloader" FontSize="32" FontWeight="SemiBold" Foreground="#B794F6"/>
            </StackPanel>

            <StackPanel Grid.Row="3" HorizontalAlignment="Center">
                <TextBlock Text="by ProdigyNova" Foreground="#A1A1AA" FontSize="14" HorizontalAlignment="Center"/>
                <TextBlock Text="v1.0.0" Foreground="#6B6B76" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                <ProgressBar IsIndeterminate="True" Width="160" Height="3" Margin="0,18,0,0"
                             Foreground="#B794F6" Background="#1C1C22" BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
