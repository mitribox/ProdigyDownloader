<Window x:Class="ClonerApp.App.Views.ProjectDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Height="560" Width="760"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="20">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Open folder" Style="{StaticResource SecondaryButton}" Command="{Binding OpenFolderCommand}" Margin="0,0,8,0"/>
                <Button Content="Pause" Style="{StaticResource SecondaryButton}" Command="{Binding PauseCommand}" Margin="0,0,8,0"/>
                <Button Content="Cancel run" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Stats}" Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
        </DockPanel>

        <UniformGrid DockPanel.Dock="Top" Columns="3" Margin="0,0,0,16">
            <Border Style="{StaticResource CardBorder}" Margin="0,0,8,8">
                <StackPanel>
                    <TextBlock Text="Pages" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="{Binding Pages}" FontSize="24" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="0,0,8,8">
                <StackPanel>
                    <TextBlock Text="Found" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="{Binding Found}" FontSize="24" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Downloaded" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="{Binding Downloaded}" FontSize="24" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Skipped" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="{Binding Skipped}" FontSize="24" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Filtered" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="{Binding Filtered}" FontSize="24" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Failed" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="{Binding Failed}" FontSize="24" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Style="{StaticResource CardBorder}" Padding="0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Live log" FontWeight="SemiBold" Margin="16,12,16,8"/>
                <ListBox ItemsSource="{Binding LogLines}" BorderThickness="0" Margin="8"/>
            </DockPanel>
        </Border>
    </DockPanel>
</Window>
