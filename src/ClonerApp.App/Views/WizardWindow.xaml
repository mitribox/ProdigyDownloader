<Window x:Class="ClonerApp.App.Views.WizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:ClonerApp.App.Converters"
        Title="ProdigyDownloader: New Project"
        Height="660" Width="740"
        MinHeight="540" MinWidth="660"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Window.Resources>
        <conv:IntEqualsToVisibilityConverter x:Key="StepVisible"/>
        <conv:BoolToVisibilityConverter x:Key="BoolVisible"/>
        <conv:InverseBoolConverter x:Key="NotBool"/>
        <Style x:Key="NextButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLastStep}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CreateButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLastStep}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel Margin="20">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="{Binding StepTitle}" FontSize="22" FontWeight="SemiBold"/>
        </DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <TextBlock DockPanel.Dock="Top" Text="{Binding ValidationError}" Foreground="#B42318" Margin="0,0,0,8" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Back" Style="{StaticResource SecondaryButton}" Command="{Binding BackCommand}" Margin="0,0,8,0"
                        IsEnabled="{Binding CanGoBack}"/>
                <Button Content="Next" Style="{StaticResource NextButtonStyle}" Command="{Binding NextCommand}" Margin="0,0,8,0"/>
                <Button Content="Create" Style="{StaticResource CreateButtonStyle}" Command="{Binding FinishCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource NotBool}}"/>
            </StackPanel>
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <StackPanel Visibility="{Binding StepIndex, Converter={StaticResource StepVisible}, ConverterParameter=0}">
                    <TextBlock Text="Project name" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Config.ProjectName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                    <TextBlock Text="URL selection" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Config.UrlInputModes}" SelectedItem="{Binding Config.UrlInputMode}" Margin="0,0,0,12"/>
                    <TextBlock Text="Start URL(s): one per line" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Config.StartUrls, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="100"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"/>
                    <StackPanel Visibility="{Binding Config.IsAdvancedUrlMode, Converter={StaticResource BoolVisible}}">
                        <TextBlock Text="URL regex" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Config.UrlRegex, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                                   Text="Advanced: only follow page links matching this regex. Example: ^https://xyz\.com/blog\.php/"/>
                    </StackPanel>
                    <TextBlock Visibility="{Binding Config.IsSimpleUrlMode, Converter={StaticResource BoolVisible}}"
                               TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                               Text="Simple: paste one or more absolute URLs to crawl."/>
                </StackPanel>

                <StackPanel Visibility="{Binding StepIndex, Converter={StaticResource StepVisible}, ConverterParameter=1}">
                    <CheckBox Content="Crawl entire website (same domain)" IsChecked="{Binding Config.CrawlEntireSite}" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"
                               Text="Uses high limits and sitemap URLs when available."
                               Visibility="{Binding Config.CrawlEntireSite, Converter={StaticResource BoolVisible}}"/>
                    <Grid Margin="0,0,0,12" Visibility="{Binding Config.ShowLimitedScanControls, Converter={StaticResource BoolVisible}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Scan depth" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding Config.MaxDepth}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Max pages" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding Config.MaxPages}"/>
                        </StackPanel>
                    </Grid>
                    <CheckBox Content="Same domain only" IsChecked="{Binding Config.SameDomainOnly}"
                              IsEnabled="{Binding Config.ShowLimitedScanControls}"/>
                    <CheckBox Content="Scan only within the starting folder and below" IsChecked="{Binding Config.ScanWithinStartingFolder}"
                              IsEnabled="{Binding Config.ShowLimitedScanControls}"/>
                    <CheckBox Content="Ignore main/home page" IsChecked="{Binding Config.IgnoreHomePage}"/>
                    <CheckBox Content="Always scan image links" IsChecked="{Binding Config.AlwaysScanImageLinks}"/>
                    <CheckBox Content="Honor robots.txt (used for sitemap discovery)" IsChecked="{Binding Config.HonorRobotsTxt}" Margin="0,8,0,0"/>
                </StackPanel>

                <StackPanel Visibility="{Binding StepIndex, Converter={StaticResource StepVisible}, ConverterParameter=2}">
                    <TextBlock Text="Category" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Config.MediaCategories}" SelectedItem="{Binding Config.MediaCategory}" Margin="0,0,0,12"/>
                    <TextBlock Text="File types" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding Config.ExtensionOptions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Extension}" IsChecked="{Binding IsSelected}" Margin="0,0,16,8" MinWidth="70"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Visibility="{Binding StepIndex, Converter={StaticResource StepVisible}, ConverterParameter=3}">
                    <TextBlock Text="Optional filters: leave blank to skip" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/>
                    <TextBlock Text="Minimum file size" Margin="0,0,0,4"/>
                    <DockPanel Margin="0,0,0,12">
                        <ComboBox DockPanel.Dock="Right" Width="80" ItemsSource="{Binding Config.SizeUnits}" SelectedItem="{Binding Config.MinFileSizeUnit}" Margin="8,0,0,0"/>
                        <TextBox Text="{Binding Config.MinFileSizeText, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                    <TextBlock Text="Minimum width (px)" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Config.MinWidthText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                    <TextBlock Text="Minimum height (px)" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Config.MinHeightText, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Visibility="{Binding StepIndex, Converter={StaticResource StepVisible}, ConverterParameter=4}">
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"
                               Text="Skip downloads when rules match. Combine with AND/OR. Tag is the HTML element (img, a, source, video, css)."/>
                    <ItemsControl ItemsSource="{Binding Config.ExcludeRules}" Margin="0,0,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Content="Remove" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                            Command="{Binding DataContext.Config.RemoveExcludeRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{Binding DataContext.Config.RuleJoinChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedValue="{Binding JoinWithPrevious}"
                                                  SelectedValuePath="Value"
                                                  DisplayMemberPath="Label"
                                                  Visibility="{Binding ShowJoin, Converter={StaticResource BoolVisible}}"/>
                                        <ComboBox Grid.Column="2"
                                                  ItemsSource="{Binding DataContext.Config.ExcludeFieldChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedValue="{Binding Field}"
                                                  SelectedValuePath="Value"
                                                  DisplayMemberPath="Label"/>
                                        <ComboBox Grid.Column="4"
                                                  ItemsSource="{Binding DataContext.Config.ExcludeOperatorChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedValue="{Binding Operator}"
                                                  SelectedValuePath="Value"
                                                  DisplayMemberPath="Label"/>
                                        <TextBox Grid.Column="6" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Add rule" Style="{StaticResource PrimaryButton}"
                                Command="{Binding Config.AddExcludeRuleCommand}" Margin="0,0,8,0"/>
                        <Button Content="Clear rules" Style="{StaticResource SecondaryButton}"
                                Command="{Binding Config.ClearExcludeRulesCommand}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Visibility="{Binding StepIndex, Converter={StaticResource StepVisible}, ConverterParameter=5}">
                    <TextBlock Text="Max simultaneous connections (1-16)" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Config.MaxConnections}" Margin="0,0,0,12"/>
                    <TextBlock Text="Delay between page requests (ms)" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Config.PageDelayMs}" Margin="0,0,0,12"/>
                    <CheckBox Content="Skip duplicates by content hash" IsChecked="{Binding Config.DeduplicateByHash}"/>
                    <CheckBox Content="Save a versioned file when content changes" IsChecked="{Binding Config.VersionOnChange}"/>
                </StackPanel>

                <StackPanel Visibility="{Binding StepIndex, Converter={StaticResource StepVisible}, ConverterParameter=6}">
                    <TextBlock Text="Output folder" Margin="0,0,0,4"/>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="Browse…" Style="{StaticResource SecondaryButton}" Command="{Binding Config.BrowseFolderCommand}" Margin="8,0,0,0"/>
                        <TextBox Text="{Binding Config.OutputRoot, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                    <TextBlock Text="How to store files" Margin="0,0,0,8"/>
                    <ComboBox ItemsSource="{Binding Config.StorageChoices}"
                              SelectedValue="{Binding Config.StorageLayout}"
                              SelectedValuePath="Value"
                              DisplayMemberPath="Label"
                              Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                               Text="A = one folder for everything. B = create a folder per page title for easier browsing."/>
                </StackPanel>

                <StackPanel Visibility="{Binding StepIndex, Converter={StaticResource StepVisible}, ConverterParameter=7}">
                    <TextBlock Text="Run mode" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Config.RunModeChoices}"
                              SelectedValue="{Binding Config.RunMode}"
                              SelectedValuePath="Value"
                              DisplayMemberPath="Label"
                              Margin="0,0,0,12"/>
                    <StackPanel Visibility="{Binding Config.IsRunWatch, Converter={StaticResource BoolVisible}}">
                        <TextBlock Text="Check every (minutes)" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Config.MonitorIntervalMinutes}" Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                                   Text="Checks for new pages and downloads new files."/>
                    </StackPanel>
                    <StackPanel Visibility="{Binding Config.IsRunSchedule, Converter={StaticResource BoolVisible}}">
                        <TextBlock Text="Schedule time (HH:mm, local)" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Config.ScheduleTime}" Margin="0,0,0,12"/>
                        <TextBlock Text="Schedule days" Margin="0,0,0,8"/>
                        <WrapPanel>
                            <CheckBox Content="Mon" IsChecked="{Binding Config.ScheduleMon}" Margin="0,0,12,8"/>
                            <CheckBox Content="Tue" IsChecked="{Binding Config.ScheduleTue}" Margin="0,0,12,8"/>
                            <CheckBox Content="Wed" IsChecked="{Binding Config.ScheduleWed}" Margin="0,0,12,8"/>
                            <CheckBox Content="Thu" IsChecked="{Binding Config.ScheduleThu}" Margin="0,0,12,8"/>
                            <CheckBox Content="Fri" IsChecked="{Binding Config.ScheduleFri}" Margin="0,0,12,8"/>
                            <CheckBox Content="Sat" IsChecked="{Binding Config.ScheduleSat}" Margin="0,0,12,8"/>
                            <CheckBox Content="Sun" IsChecked="{Binding Config.ScheduleSun}" Margin="0,0,12,8"/>
                        </WrapPanel>
                    </StackPanel>
                    <TextBlock Visibility="{Binding Config.IsRunOnce, Converter={StaticResource BoolVisible}}"
                               TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                               Text="Download once runs when you create/start the project."/>
                </StackPanel>

                <StackPanel Visibility="{Binding StepIndex, Converter={StaticResource StepVisible}, ConverterParameter=8}">
                    <TextBox Text="{Binding Summary}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="300" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"/>
                    <CheckBox Content="Start download now" IsChecked="{Binding StartNow}"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
